# Copy to .env and fill in as later phases need them. Nothing here is
# required for Phase 1 (browser + files tools, rule-based intent/healer).

# Used only if you switch models/provider.py to a hosted API instead of
# a local Hugging Face pipeline.
# HF_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Browser Use (Phase 4), if you plug in a hosted model provider for it.
# BROWSER_USE_MODEL_PROVIDER=
